#! rockbox/tagbrowser/2.0
# emepetres: compact library for the AGPTEK Rocker.
# A pre-existing /.rockbox/tagnavi_user.config still takes precedence.
# Keep standard labels where possible for Rockbox's translation/voice lookup.

%format "fmt_title" "%s - %02d:%02d (%s)" basename Lm Ls filename ? title == "[Untagged]"
%format "fmt_title" "%d.%02d. %s - %02d:%02d" discnum tracknum title Lm Ls ? discnum > "0"
%format "fmt_title" "%02d. %s - %02d:%02d" tracknum title Lm Ls ? tracknum > "0"
%format "fmt_title" "%s - %02d:%02d" title Lm Ls

%include "/.rockbox/tagnavi_custom.config"

%byfirstletter "artist_a2z" "Artists by First Letter" "canonicalartist"
%byfirstletter "album_a2z" "Albums by First Letter" "album"

%menu_start "a2z" "By First Letter..."
"Artists" ==> "artist_a2z"
"Albums" ==> "album_a2z"

%menu_start "search" "Search by..."
"Artist" -> canonicalartist ? canonicalartist ~ "" -> album -> title = "fmt_title"
"Album" -> album ? album ~ "" -> title = "fmt_title"
"Title" -> title = "fmt_title" ? title ~ ""

# Reserved entry points for the emepetres Home. Separate queries keep each
# route's search/selection history independent of the advanced database menu.
%menu_start "emepetres_artists" "Artists"
"Artist" -> canonicalartist -> album -> title = "fmt_title"

%menu_start "emepetres_albums" "Albums"
"Album" -> album -> title = "fmt_title"

%menu_start "emepetres_search" "Search by..."
"Artist" -> canonicalartist ? canonicalartist ~ "" -> album -> title = "fmt_title"
"Album" -> album ? album ~ "" -> title = "fmt_title"
"Title" -> title = "fmt_title" ? title ~ ""
"First Letter" ==> "a2z"

%menu_start "emepetres_shuffle" "Shuffle Songs"
"Shuffle Songs" ~> title = "fmt_title"

%menu_start "main" "Database"
"Artist" -> canonicalartist -> album -> title = "fmt_title"
"Album" -> album -> title = "fmt_title"
"Shuffle Songs" ~> title = "fmt_title"
"Search" ==> "search"
"First Letter" ==> "a2z"
"Custom menu" ==> "custom"

%root_menu "main"
